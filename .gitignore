# Assets Drive sync ignores (Addendum 2)
/assets/images/*
!/assets/images/README.md
!/assets/images/drive-manifest.json
/assets/binaries/*
!/assets/binaries/README.md
!/assets/binaries/drive-manifest.json

# Video assets Drive sync (Addendum 5)
/assets/videos/*
!/assets/videos/README.md
!/assets/videos/drive-manifest.json

# Untracked media files outside assets
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.png
*.jpg
*.jpeg
*.gif
*.webp

# Assets Drive sync ignores (Addendum 2 & 5)
/assets/images/*
